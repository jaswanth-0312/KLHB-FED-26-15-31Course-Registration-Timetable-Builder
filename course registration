
import java.util.Scanner;

public class CourseRegistration {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] courses = new String[10];
        int n;

        System.out.print("Enter number of courses (1-10): ");
        n = sc.nextInt();
        sc.nextLine();

        // Course registration using for loop
        for (int i = 0; i < n; i++) {
            System.out.print("Enter course name " + (i + 1) + ": ");
            courses[i] = sc.nextLine();
        }

        // Display registered courses and timetable
        System.out.println("\n--- Course Registration and Timetable ---");

        for (int i = 0; i < n; i++) {
            System.out.println("Period " + (i + 1) + ": "
                    + courses[i]);
        }

        sc.close();
    }
}
