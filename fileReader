
import java.io.FileWriter;
import java.io.FileReader;
import java.io.IOException;
import java.util.Scanner;

class CourseRegistration {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        try {
            FileWriter fw = new FileWriter("courses.txt");

            System.out.println("COURSE REGISTRATION");

            System.out.print("Enter student name: ");
            String name = sc.nextLine();

            System.out.print("Enter course name: ");
            String course = sc.nextLine();

            fw.write("Student Name: " + name + "\n");
            fw.write("Course Name: " + course + "\n");

            System.out.println("\nRegistration saved successfully!");

            FileReader fr = new FileReader("courses.txt");

            int ch;
            System.out.println("\nCOURSE REGISTRATION DETAILS:");

            while ((ch = fr.read()) != -1) {
                System.out.print((char) ch);
            }


        } catch (IOException e) {
            System.out.println("File error occurred.");
        }

      
    }
}
