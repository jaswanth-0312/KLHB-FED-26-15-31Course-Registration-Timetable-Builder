
import java.util.Scanner;

class CourseRegistration {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        try {
            String[] courses = {"Java", "Mathematics", "Physics", "English"};

            System.out.println("COURSE REGISTRATION AND TIMETABLE BUILDER");

            System.out.println("\nAvailable Courses:");
            for (int i = 0; i < courses.length; i++) {
                System.out.println((i + 1) + ". " + courses[i]);
            }

            System.out.print("\nEnter course number to register: ");
            int choice = sc.nextInt();

            if (choice < 1 || choice > 4) {
                throw new Exception("Invalid course number!");
            }

            System.out.println("\nCourse Registered: " + courses[choice - 1]);

            System.out.println("\nWEEKLY TIME TABLE");
            System.out.println("Monday    - Java");
            System.out.println("Tuesday   - Mathematics");
            System.out.println("Wednesday - Physics");
            System.out.println("Thursday  - English");

        } catch (java.util.InputMismatchException e) {
            System.out.println("Error: Please enter a number.");
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        } finally {
            System.out.println("\nThank you for using the system!");
          
        }
    }
}
